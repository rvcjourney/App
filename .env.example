
  
#Provide your Static authentication token below
REACT_APP_VIDEOSDK_TOKEN = ""

#OR

#Provide your authentication server base url (use same IP for frontend and backend)
REACT_APP_AUTH_URL = "http://192.168.1.18:3000"

#Any one value from above is mandatory for testing purpose
#For production deployment, we recommend using an Authentication server instead of static token

# LearningPlatform (Vite web admin) – optional; defaults work if backend .env has Supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_from_supabase_dashboard
# VITE_API_URL=http://192.168.1.18:3000