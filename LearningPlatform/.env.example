# ==========================================
# VITE React App Environment Variables
# ==========================================

# ==========================================
# Backend API Configuration
# ==========================================
# REQUIRED: Backend server URL for API calls
# Development: http://localhost:3000
# Production: https://your-api.example.com (use HTTPS in production)
VITE_API_URL=http://localhost:3000

# ==========================================
# Supabase Configuration
# ==========================================
# Get from: https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ==========================================
# App Configuration
# ==========================================
# Application name
VITE_APP_NAME=LearningPlatform Admin

# Application version
VITE_APP_VERSION=1.0.0

# ==========================================
# Feature Flags (Optional)
# ==========================================
# Enable debug mode (shows additional logs)
VITE_DEBUG=false

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================
# 1. NEVER commit .env file to git - only commit .env.example
# 2. VITE_SUPABASE_ANON_KEY is public - use Row Level Security in Supabase
# 3. Use HTTPS for VITE_API_URL in production
# 4. Each developer should have their own .env file
# 5. For deployment:
#    - Use CI/CD secrets (GitHub Secrets, GitLab Variables, etc.)
#    - Or use environment variables from deployment platform
#    - Never hardcode secrets in source code
