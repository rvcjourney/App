# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Get your URL and key from: https://supabase.com
# Use SERVICE ROLE KEY for server-side operations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==========================================
# VideoSDK Token Server Configuration
# ==========================================
# Get your API Key and Secret from: https://app.videosdk.live/settings
# Keep SECRET KEY private and never expose in frontend!
VIDEOSDK_API_KEY=your_api_key_here
VIDEOSDK_SECRET_KEY=your_secret_key_here

# ==========================================
# Razorpay Configuration
# ==========================================
# Get your keys from: https://dashboard.razorpay.com/settings/api-keys
# Use TEST keys for development, LIVE keys for production
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# ==========================================
# Email Configuration (Gmail Example)
# ==========================================
# Using Gmail: https://myaccount.google.com/apppasswords
# EMAIL_PASSWORD is the app password, NOT your Gmail password
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Logging Configuration (Optional)
# ==========================================
LOG_LEVEL=info
# LOG_LEVEL options: error, warn, info, http, debug, verbose, silly

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================
# 1. NEVER commit the actual .env file to git
# 2. .env.example is a template - share this with team
# 3. Each developer should have their own .env file
# 4. For production, use environment variables from:
#    - Docker secrets
#    - Kubernetes secrets
#    - Cloud provider (AWS Secrets Manager, Azure Key Vault, etc.)
# 5. Rotate API keys regularly
# 6. Monitor for unauthorized access
# 7. Use different keys for dev/staging/production
